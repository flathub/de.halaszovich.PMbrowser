{
  "app-id": "de.halaszovich.PMbrowser",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
    "platform-extensions": [
    "org.kde.Platform.Locale"
  ],
  "command": "QtPMbrowser",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "Pmbrowser",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_DOCS=off"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/ChrisHal/PMbrowser.git",
          "commit": "2999d642007806a985348b677d344d94c13a0670"
        }
      ]
    }
  ]
}

